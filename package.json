  "repository": {
    "type": "git",
    "url": "https://github.com/trackly-app/trackly-cli"
  },
  "homepage": "https://usetrackly.app/cli",
  "bugs": {
    "url": "https://github.com/trackly-app/trackly-cli/issues"
  },
